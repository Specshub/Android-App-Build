<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:background="@drawable/bg_list_row" android:clickable="true" android:focusable="true" android:gravity="center_vertical" android:orientation="horizontal" android:padding="12dp">
<TextView android:id="@+id/rowAvatar" android:layout_width="42dp" android:layout_height="42dp" android:background="@drawable/bg_list_avatar" android:gravity="center" android:textColor="#F5C84C" android:textSize="18sp" android:textStyle="bold" />
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:layout_marginEnd="8dp" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/rowName" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#FFFFFF" android:textSize="16sp" android:textStyle="bold" /><TextView android:id="@+id/rowHost" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:textColor="#99FFFFFF" android:textDirection="ltr" android:textSize="12sp" /></LinearLayout>
<ImageView android:id="@+id/rowCheck" android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_check_gold" android:visibility="gone" />
</LinearLayout>
