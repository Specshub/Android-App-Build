<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_dialog_card" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/nav_lists" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/lists_sub" android:textColor="#99FFFFFF" android:textSize="12sp" />
<ScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"><LinearLayout android:id="@+id/listBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" /></ScrollView>
<TextView android:id="@+id/btnClose" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="14dp" android:background="@drawable/bg_outline_btn" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/cancel" android:textColor="#FFFFFF" android:textSize="14sp" />
</LinearLayout>
