<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_app_gradient" android:layoutDirection="ltr" android:orientation="horizontal">
<LinearLayout android:layout_width="220dp" android:layout_height="match_parent" android:background="#CC080808" android:orientation="vertical" android:padding="10dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:text="@string/set_title" android:textColor="#E0A81E" android:textSize="20sp" android:textStyle="bold" />
<TextView android:id="@+id/tabAccount" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_row" android:clickable="true" android:focusable="true" android:padding="14dp" android:text="@string/set_account" android:textColor="#FFFFFF" android:textSize="16sp" />
<TextView android:id="@+id/tabGeneral" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_row" android:clickable="true" android:focusable="true" android:padding="14dp" android:text="@string/set_general" android:textColor="#FFFFFF" android:textSize="16sp" />
<TextView android:id="@+id/tabPlayer" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_row" android:clickable="true" android:focusable="true" android:padding="14dp" android:text="@string/set_player" android:textColor="#FFFFFF" android:textSize="16sp" />
</LinearLayout>
<FrameLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:padding="20dp">
<ScrollView android:id="@+id/paneAccount" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="@string/set_account_info" android:textColor="#E0A81E" android:textSize="20sp" android:textStyle="bold" />
<LinearLayout style="@style/SettingRow"><TextView style="@style/SettingLabel" android:text="@string/set_expiry" /><TextView android:id="@+id/vExpiry" style="@style/SettingValue" /></LinearLayout>
<LinearLayout style="@style/SettingRow"><TextView style="@style/SettingLabel" android:text="@string/act_device_key" /><TextView android:id="@+id/vKey" style="@style/SettingValue" /></LinearLayout>
<LinearLayout style="@style/SettingRow"><TextView style="@style/SettingLabel" android:text="MAC Address" /><TextView android:id="@+id/vMac" style="@style/SettingValue" /></LinearLayout>
<LinearLayout style="@style/SettingRow"><TextView style="@style/SettingLabel" android:text="@string/set_device" /><TextView android:id="@+id/vDevice" style="@style/SettingValue" /></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp" android:text="@string/set_disc" android:textColor="#99FFFFFF" android:textSize="12sp" />
<LinearLayout style="@style/SettingRow"><TextView style="@style/SettingLabel" android:text="@string/set_version" /><TextView android:id="@+id/vVersion" style="@style/SettingValue" /></LinearLayout>
</LinearLayout></ScrollView>
<LinearLayout android:id="@+id/paneGeneral" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
<TextView android:id="@+id/btnTheme" style="@style/SettingBtn" android:text="@string/set_theme" />
<TextView android:id="@+id/btnLogout" style="@style/SettingBtn" android:text="@string/set_logout" android:textColor="#FF5252" />
</LinearLayout>
<LinearLayout android:id="@+id/panePlayer" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
<androidx.appcompat.widget.SwitchCompat android:id="@+id/swAuto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_row" android:focusable="true" android:padding="16dp" android:text="@string/set_auto" android:textColor="#FFFFFF" android:textSize="16sp" />
<androidx.appcompat.widget.SwitchCompat android:id="@+id/swFill" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_row" android:focusable="true" android:padding="16dp" android:text="@string/set_fill" android:textColor="#FFFFFF" android:textSize="16sp" />
</LinearLayout>
</FrameLayout>
</LinearLayout>
