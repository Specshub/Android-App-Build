<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_dialog_card" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="locale" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/sub_title" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/sub_sub" android:textColor="#99FFFFFF" android:textSize="12sp" />
<EditText android:id="@+id/etUrl" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="14dp" android:background="@drawable/bg_input" android:hint="@string/sub_hint_url" android:imeOptions="actionNext" android:inputType="textUri" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textDirection="ltr" android:textSize="14sp" />
<EditText android:id="@+id/etUser" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="@string/sub_hint_user" android:imeOptions="actionNext" android:inputType="text" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textDirection="ltr" android:textSize="14sp" />
<EditText android:id="@+id/etPass" android:layout_width="match_parent" android:layout_height="46dp" android:layout_marginTop="8dp" android:background="@drawable/bg_input" android:hint="@string/sub_hint_pass" android:imeOptions="actionDone" android:inputType="textPassword" android:paddingStart="14dp" android:paddingEnd="14dp" android:singleLine="true" android:textColor="#FFFFFF" android:textColorHint="#66FFFFFF" android:textDirection="ltr" android:textSize="14sp" />
<TextView android:id="@+id/tvSubStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textColor="#FFB4A9" android:textSize="12sp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal"><TextView android:id="@+id/btnSubGo" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:background="@drawable/bg_gold_btn" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/sub_login" android:textColor="#1A1200" android:textSize="14sp" android:textStyle="bold" /><TextView android:id="@+id/btnSubCancel" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="10dp" android:layout_weight="1" android:background="@drawable/bg_outline_btn" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/cancel" android:textColor="#FFFFFF" android:textSize="14sp" /></LinearLayout>
</LinearLayout></ScrollView>
