<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#050505" android:layoutDirection="ltr" android:orientation="horizontal">
<ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.1" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layoutDirection="locale" android:orientation="vertical" android:padding="24dp">
<ImageView android:layout_width="96dp" android:layout_height="96dp" android:src="@drawable/ic_launcher_aurum" />
<TextView android:id="@+id/tvAppName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:letterSpacing="0.2" android:textColor="#E0A81E" android:textSize="26sp" android:textStyle="bold" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/act_badge" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/act_tagline" android:textColor="#B3FFFFFF" android:textSize="13sp" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical" android:orientation="horizontal"><ProgressBar android:id="@+id/progress" android:layout_width="20dp" android:layout_height="20dp" /><TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/status_waiting" android:textColor="#E0A81E" android:textSize="14sp" /></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="@string/act_disc_long" android:textColor="#99FFFFFF" android:textSize="11sp" android:gravity="center" />
</LinearLayout></ScrollView>
<ScrollView android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/bg_activation_panel" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layoutDirection="locale" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="@string/act_title" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="@string/act_sub" android:textColor="#E6FFFFFF" android:textSize="12sp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_step_num" android:gravity="center" android:text="1" android:textColor="#1A1200" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/act_visit" android:textColor="#FFFFFF" android:textSize="13sp" /><TextView android:id="@+id/tvSite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#FFD670" android:textDirection="ltr" android:textSize="13sp" android:textStyle="bold" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_step_num" android:gravity="center" android:text="2" android:textColor="#1A1200" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="@string/act_login_long" android:textColor="#FFFFFF" android:textSize="13sp" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_code_box" android:gravity="center" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/act_device_id" android:textColor="#B3FFFFFF" android:textSize="11sp" /><TextView android:id="@+id/tvMac" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="#FFFFFF" android:textDirection="ltr" android:textIsSelectable="true" android:textSize="22sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/act_device_key" android:textColor="#B3FFFFFF" android:textSize="11sp" /><TextView android:id="@+id/tvKey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:letterSpacing="0.15" android:textColor="#FFD670" android:textDirection="ltr" android:textIsSelectable="true" android:textSize="26sp" android:textStyle="bold" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_step_num" android:gravity="center" android:text="3" android:textColor="#1A1200" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="@string/act_after" android:textColor="#FFFFFF" android:textSize="13sp" /></LinearLayout>
<TextView android:id="@+id/btnRefresh" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/bg_gold_btn" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/act_refresh" android:textColor="#1A1200" android:textSize="15sp" android:textStyle="bold" />
<LinearLayout android:id="@+id/demoHolder" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
</LinearLayout></ScrollView>
</LinearLayout>
