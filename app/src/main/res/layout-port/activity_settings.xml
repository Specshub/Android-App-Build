<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_app_gradient" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp" android:text="الإعدادات" android:textColor="#E0A81E" android:textSize="20sp" android:textStyle="bold" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingStart="8dp" android:paddingEnd="8dp">
<TextView android:id="@+id/tabAccount" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/bg_row" android:clickable="true" android:focusable="true" android:gravity="center" android:padding="12dp" android:text="الحساب" android:textColor="#FFFFFF" android:textSize="15sp" />
<TextView android:id="@+id/tabGeneral" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/bg_row" android:clickable="true" android:focusable="true" android:gravity="center" android:padding="12dp" android:text="عام" android:textColor="#FFFFFF" android:textSize="15sp" />
<TextView android:id="@+id/tabPlayer" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_margin="3dp" android:layout_weight="1" android:background="@drawable/bg_row" android:clickable="true" android:focusable="true" android:gravity="center" android:padding="12dp" android:text="المشغل" android:textColor="#FFFFFF" android:textSize="15sp" />
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:padding="16dp">
<ScrollView android:id="@+id/paneAccount" android:layout_width="match_parent" android:layout_height="match_parent"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="معلومات الحساب" android:textColor="#E0A81E" android:textSize="18sp" android:textStyle="bold" />
<LinearLayout style="@style/SettingRow"><TextView style="@style/SettingLabel" android:text="تاريخ الانتهاء" /><TextView android:id="@+id/vExpiry" style="@style/SettingValue" /></LinearLayout>
<LinearLayout style="@style/SettingRow"><TextView style="@style/SettingLabel" android:text="مفتاح الجهاز" /><TextView android:id="@+id/vKey" style="@style/SettingValue" /></LinearLayout>
<LinearLayout style="@style/SettingRow"><TextView style="@style/SettingLabel" android:text="MAC Address" /><TextView android:id="@+id/vMac" style="@style/SettingValue" /></LinearLayout>
<LinearLayout style="@style/SettingRow"><TextView style="@style/SettingLabel" android:text="الجهاز" /><TextView android:id="@+id/vDevice" style="@style/SettingValue" /></LinearLayout>
<LinearLayout style="@style/SettingRow"><TextView style="@style/SettingLabel" android:text="الإصدار" /><TextView android:id="@+id/vVersion" style="@style/SettingValue" /></LinearLayout>
<LinearLayout style="@style/SettingRow"><TextView style="@style/SettingLabel" android:text="الدعم الفني" /><TextView android:id="@+id/vPhone" style="@style/SettingValue" /></LinearLayout>
</LinearLayout></ScrollView>
<LinearLayout android:id="@+id/paneGeneral" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
<TextView android:id="@+id/btnLang" style="@style/SettingBtn" android:text="تغيير اللغة" />
<TextView android:id="@+id/btnTheme" style="@style/SettingBtn" android:text="الوضع الليلي / النهاري" />
<TextView android:id="@+id/btnSupport" style="@style/SettingBtn" android:text="الدعم الفني (واتساب)" />
<TextView android:id="@+id/btnLogout" style="@style/SettingBtn" android:text="تسجيل الخروج" android:textColor="#FF5252" />
</LinearLayout>
<LinearLayout android:id="@+id/panePlayer" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="gone">
<androidx.appcompat.widget.SwitchCompat android:id="@+id/swAuto" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_row" android:focusable="true" android:padding="16dp" android:text="تشغيل آخر قناة تلقائياً" android:textColor="#FFFFFF" android:textSize="15sp" />
<androidx.appcompat.widget.SwitchCompat android:id="@+id/swFill" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/bg_row" android:focusable="true" android:padding="16dp" android:text="ملء الشاشة في القنوات المباشرة" android:textColor="#FFFFFF" android:textSize="15sp" />
</LinearLayout>
</FrameLayout>
</LinearLayout>
