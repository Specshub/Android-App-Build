<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#050505" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layoutDirection="rtl" android:orientation="vertical" android:padding="24dp">
<ImageView android:layout_width="96dp" android:layout_height="96dp" android:src="@drawable/ic_launcher_aurum" />
<TextView android:id="@+id/tvAppName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:letterSpacing="0.2" android:textColor="#E0A81E" android:textSize="26sp" android:textStyle="bold" />
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="تجربة ترفيهية فاخرة" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="مشغّل وسائط سريع وأنيق لقوائم التشغيل الخاصة بك، بواجهة مصممة لأفضل تجربة مشاهدة." android:textColor="#B3FFFFFF" android:textSize="13sp" />
<LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:gravity="center_vertical" android:orientation="horizontal"><ProgressBar android:id="@+id/progress" android:layout_width="20dp" android:layout_height="20dp" /><TextView android:id="@+id/tvStatus" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="في انتظار التفعيل..." android:textColor="#E0A81E" android:textSize="14sp" /></LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:text="هذا التطبيق مشغّل وسائط فقط، ولا يتضمن أو يوفّر أي قنوات أو أفلام أو مسلسلات أو محتوى. يجب عليك إضافة قائمة التشغيل الخاصة بك التي تملك حق استخدامها." android:textColor="#99FFFFFF" android:textSize="11sp" android:gravity="center" />
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/bg_activation_panel" android:layoutDirection="rtl" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:text="لتفعيل التطبيق" android:textColor="#FFFFFF" android:textSize="21sp" android:textStyle="bold" />
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="أضف قائمة التشغيل الخاصة بك عبر موقعنا وسيعمل التطبيق تلقائيًا" android:textColor="#E6FFFFFF" android:textSize="12sp" />
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_step_num" android:gravity="center" android:text="1" android:textColor="#1A1200" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="زُر الموقع:" android:textColor="#FFFFFF" android:textSize="13sp" /><TextView android:id="@+id/tvSite" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="#FFD670" android:textDirection="ltr" android:textSize="13sp" android:textStyle="bold" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_step_num" android:gravity="center" android:text="2" android:textColor="#1A1200" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="سجّل الدخول بمعرف جهازك ومفتاحه الفريد:" android:textColor="#FFFFFF" android:textSize="13sp" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_code_box" android:gravity="center" android:orientation="vertical" android:padding="12dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="معرّف الجهاز" android:textColor="#B3FFFFFF" android:textSize="11sp" /><TextView android:id="@+id/tvMac" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:textColor="#FFFFFF" android:textDirection="ltr" android:textIsSelectable="true" android:textSize="22sp" android:textStyle="bold" /><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="مفتاح الجهاز" android:textColor="#B3FFFFFF" android:textSize="11sp" /><TextView android:id="@+id/tvKey" android:layout_width="wrap_content" android:layout_height="wrap_content" android:fontFamily="monospace" android:letterSpacing="0.15" android:textColor="#FFD670" android:textDirection="ltr" android:textIsSelectable="true" android:textSize="26sp" android:textStyle="bold" /></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="26dp" android:layout_height="26dp" android:background="@drawable/bg_step_num" android:gravity="center" android:text="3" android:textColor="#1A1200" android:textStyle="bold" /><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="بعد التفعيل يفتح التطبيق تلقائيًا، أو اضغط تحديث." android:textColor="#FFFFFF" android:textSize="13sp" /></LinearLayout>
<TextView android:id="@+id/btnRefresh" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="14dp" android:background="@drawable/bg_gold_btn" android:clickable="true" android:focusable="true" android:gravity="center" android:text="تحديث الحالة" android:textColor="#1A1200" android:textSize="15sp" android:textStyle="bold" />
<LinearLayout android:id="@+id/demoHolder" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical" />
</LinearLayout>
</LinearLayout></ScrollView>
